    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"notes\" TEXT NOT NULL, \"date\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"data_path\" TEXT NOT NULL, \"is_assessment\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_assessment\" IN (0, 1)), \"session_type\" INTEGER NOT NULL DEFAULT 0, \"duration\" INTEGER NOT NULL DEFAULT 0, \"repeater_sets\" INTEGER NULL, \"repeater_reps\" INTEGER NULL, \"repeater_work_time\" INTEGER NULL, \"repeater_rest_time\" INTEGER NULL, \"repeater_set_rest\" INTEGER NULL, \"repeater_split_hand\" INTEGER NULL CHECK (\"repeater_split_hand\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NOT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dirty\" IN (0, 1)), \"remote_id\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "assessments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assessments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" INTEGER NOT NULL, \"right_value\" REAL NULL, \"left_value\" REAL NULL, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id), \"grip_position\" INTEGER NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NOT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dirty\" IN (0, 1)), \"remote_id\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "repeaters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"repeaters\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"sets\" INTEGER NOT NULL, \"reps\" INTEGER NOT NULL, \"worktime\" INTEGER NOT NULL, \"resttime\" INTEGER NOT NULL, \"set_rest\" INTEGER NOT NULL, \"target_weigth_right\" REAL NULL, \"target_weigth_left\" REAL NULL, \"split_hand\" INTEGER NOT NULL CHECK (\"split_hand\" IN (0, 1)), \"grip_position\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NOT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dirty\" IN (0, 1)), \"remote_id\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "trainings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trainings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"repeater_id\" INTEGER NULL REFERENCES repeaters (id) ON DELETE CASCADE, \"is_builtin\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_builtin\" IN (0, 1)), \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"is_assessment\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_assessment\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NOT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dirty\" IN (0, 1)), \"remote_id\" TEXT NOT NULL);"
        }
      ]
    },

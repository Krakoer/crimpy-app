  "fixed_sql": [
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"notes\" TEXT NOT NULL, \"date\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"data_path\" TEXT NOT NULL, \"is_assessment\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_assessment\" IN (0, 1)), \"activity\" INTEGER NOT NULL DEFAULT 0, \"origin\" TEXT NOT NULL DEFAULT 'logged', \"training_id\" TEXT NULL, \"program_session_id\" TEXT NULL, \"duration\" INTEGER NOT NULL DEFAULT 0, \"repeater_sets\" INTEGER NULL, \"repeater_reps\" INTEGER NULL, \"repeater_work_time\" INTEGER NULL, \"repeater_rest_time\" INTEGER NULL, \"repeater_set_rest\" INTEGER NULL, \"repeater_split_hand\" INTEGER NULL CHECK (\"repeater_split_hand\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "assessments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assessments\" (\"id\" TEXT NOT NULL, \"type\" INTEGER NOT NULL, \"right_value\" REAL NULL, \"left_value\" REAL NULL, \"session_id\" TEXT NOT NULL, \"grip_position\" INTEGER NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"), FOREIGN KEY (session_id) REFERENCES sessions(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "trainings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trainings\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "training_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"training_items\" (\"id\" TEXT NOT NULL, \"training_id\" TEXT NOT NULL, \"parent_id\" TEXT NULL, \"type\" TEXT NOT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, \"cycles\" INTEGER NULL, \"cycle_rest_seconds\" INTEGER NULL, \"reps\" INTEGER NULL, \"duration\" INTEGER NULL, \"rest_seconds\" INTEGER NULL, \"worktime_seconds\" INTEGER NULL, \"hand\" TEXT NULL, \"granularity\" TEXT NULL, \"loads_json\" TEXT NULL, \"left_loads_json\" TEXT NULL, \"hand_positions_json\" TEXT NULL, \"edge_sizes_mm_json\" TEXT NULL, \"load_is_max\" INTEGER NOT NULL DEFAULT 0 CHECK (\"load_is_max\" IN (0, 1)), \"free_text\" TEXT NULL, \"exercise_id\" TEXT NULL, \"group_title\" TEXT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"), FOREIGN KEY (training_id) REFERENCES trainings(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "rep_datas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rep_datas\" (\"id\" TEXT NOT NULL, \"average_weight\" REAL NOT NULL, \"session_id\" TEXT NOT NULL, \"is_rest\" INTEGER NOT NULL CHECK (\"is_rest\" IN (0, 1)), \"right_hand\" INTEGER NOT NULL CHECK (\"right_hand\" IN (0, 1)), \"duration\" INTEGER NOT NULL, \"target_weight\" REAL NOT NULL, \"index\" INTEGER NOT NULL, \"grip_position\" INTEGER NOT NULL DEFAULT 0, \"edge_size_mm\" INTEGER NULL, \"training_item_id\" TEXT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"), FOREIGN KEY (session_id) REFERENCES sessions(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "sensor_configs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sensor_configs\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"index\" INTEGER NOT NULL, \"tare\" REAL NOT NULL, \"coef\" REAL NOT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
